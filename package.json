{
  "name": "@woodland/monorepo",
  "version": "0.0.0",
  "description": "An immutable database.",
  "repository": "https://github.com/PsychoLlama/woodland",
  "packageManager": "yarn@3.6.4",
  "author": "Jesse Gibson",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "run test:coverage && run test:lint && run test:fmt && run test:types",
    "test:unit": "yarn workspaces foreach --parallel run test:unit --no-watch",
    "test:coverage": "run test:unit --coverage",
    "test:types": "yarn workspaces foreach --parallel run test:types",
    "test:lint": "eslint packages/*/src --color",
    "test:fmt": "prettier --check packages/*/src --color"
  },
  "workspaces": [
    "packages/*"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{t,j}s": [
      "eslint",
      "prettier --check"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "overrides": [
      {
        "files": [
          "./**/__tests__/*.ts"
        ],
        "rules": {
          "@typescript-eslint/no-explicit-any": "off"
        }
      }
    ],
    "env": {
      "browser": true,
      "es2021": true
    },
    "plugins": [
      "@typescript-eslint",
      "import"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:import/recommended",
      "plugin:import/typescript"
    ],
    "rules": {
      "@typescript-eslint/no-namespace": "off",
      "@typescript-eslint/no-unused-vars": "error",
      "no-prototype-builtins": "off",
      "@typescript-eslint/consistent-type-imports": "error",
      "import/order": [
        "error"
      ]
    },
    "settings": {
      "import/resolver": {
        "typescript": true,
        "node": true
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "6.13.1",
    "@typescript-eslint/parser": "6.13.1",
    "eslint": "8.55.0",
    "eslint-import-resolver-typescript": "^3.5.3",
    "eslint-plugin-import": "^2.27.5",
    "husky": "8.0.3",
    "lint-staged": "15.2.0",
    "prettier": "3.1.0",
    "typescript": "5.2.2",
    "vite": "^4.1.4",
    "vitest": "^0.34.0"
  }
}
