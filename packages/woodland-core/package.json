{
  "name": "@woodland/core",
  "version": "0.0.0",
  "description": "The core of Woodland, an immutable database.",
  "type": "module",
  "author": "Jesse Gibson",
  "license": "MIT",
  "main": "./dist/woodland-core.cjs",
  "module": "./dist/woodland-core.js",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "require": "./dist/woodland-core.cjs",
      "import": "./dist/woodland-core.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PsychoLlama/woodland",
    "directory": "packages/woodland-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "client-side",
    "database",
    "immutable",
    "replicated",
    "CRDT"
  ],
  "scripts": {
    "prepack": "vite build",
    "test:unit": "vitest --color",
    "test:types": "tsc"
  },
  "dependencies": {
    "multiformats": "^13.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
