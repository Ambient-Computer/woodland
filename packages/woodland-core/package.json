{
  "name": "@woodland/core",
  "version": "0.0.0",
  "description": "The core of Woodland, an immutable database.",
  "type": "module",
  "author": "Jesse Gibson",
  "license": "MIT",
  "main": "./dist/woodland-core.cjs",
  "module": "./dist/woodland-core.js",
  "types": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "require": "./dist/woodland-core.cjs",
      "import": "./dist/woodland-core.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PsychoLlama/woodland",
    "directory": "packages/woodland-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "client-side",
    "database",
    "immutable",
    "replicated",
    "CRDT"
  ],
  "scripts": {
    "prepack": "vite build",
    "test:unit": "vitest --color",
    "test:types": "tsc"
  },
  "dependencies": {
    "multiformats": "9.9.0",
    "uuid": "9.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.14.6",
    "@types/uuid": "9.0.1",
    "@vitest/coverage-c8": "^0.29.2",
    "typescript": "4.9.5",
    "vite": "^4.1.4",
    "vitest": "^0.29.2"
  }
}
